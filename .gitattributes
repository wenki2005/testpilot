# Normalize line endings so a fresh clone behaves identically on every machine.
* text=auto

# Source and docs are authored with LF.
*.ts    text eol=lf
*.tsx   text eol=lf
*.mjs   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.sql   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Windows entry points MUST be CRLF: cmd.exe mis-parses LF-only .cmd files.
*.cmd   text eol=crlf
*.bat   text eol=crlf
*.ps1   text eol=crlf

*.png   binary
*.jpg   binary
*.zip   binary
*.mcpb  binary
