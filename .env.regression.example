# Reference fields for the regression environment. No credentials are included.
# This file is a template, not an implemented MySQL adapter or automatic loader.
# Copy to .local/regression.env if you need a local record.
REGRESSION_FRONTEND_SOURCE=
REGRESSION_WEB_BASE_URL=
REGRESSION_API_BASE_URL=
REGRESSION_DB_HOST=
REGRESSION_DB_PORT=3306
REGRESSION_DB_NAME=supply
REGRESSION_DB_USER=
REGRESSION_DB_PASSWORD=
REGRESSION_DB_CA_FILE=

# Read-only test account access token, only when the target environment needs it.
REGRESSION_ACCESS_TOKEN=
