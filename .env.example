# Optional model configuration. Settings can also be entered in the app.
TESTPILOT_API_KEY=
TESTPILOT_BASE_URL=https://api.openai.com/v1
TESTPILOT_MODEL=gpt-4.1-mini
# Dify workflow API: server-side only. Never commit a real key.
TESTPILOT_DIFY_API_KEY=
TESTPILOT_DIFY_BASE_URL=https://api.dify.ai/v1
# Optional workflow editor link shown in the regression workbench:
TESTPILOT_DIFY_WORKFLOW_URL=
# Separate published fixed-execution workflow (integrations/dify/module-execution.yml):
TESTPILOT_DIFY_EXECUTION_API_KEY=
TESTPILOT_DIFY_EXECUTION_WORKFLOW_URL=
# Optional WeCom (企业微信) group-robot webhook for Dify failure/screenshot notifications.
# Only an authorized test group; must be https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=...
# Leave empty to disable. The system must also explicitly enable failure/screenshot notifications.
TESTPILOT_DIFY_WECOM_WEBHOOK=
# Optional OpenAI-compatible endpoint, including /v1 if required by the service:
# TESTPILOT_BASE_URL=https://api.openai.com/v1
# Optional integration: install with `npm install --no-save --package-lock=false @midscene/web@1.16.0`.
# Read-only visual cross-check using Midscene.js on the same Playwright page.
# This adds one multimodal assertion call per applicable case. Choose a family
# matching the configured vision model; it is not inferred from a generic API URL.
# TESTPILOT_MIDSCENE_VISUAL_ASSERT=1
# TESTPILOT_MIDSCENE_MODEL_FAMILY=qwen3-vl
# TESTPILOT_MIDSCENE_MODEL=your-vision-model-name
# PORT=4317
