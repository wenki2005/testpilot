# Copy to .env and run npm run demo (or set these in PowerShell before npm run demo).
# The offline demo does not need a model key.
TESTPILOT_API_KEY=
TESTPILOT_MODEL=gpt-4.1-mini
# Optional OpenAI-compatible endpoint, including /v1 if required by the service:
# TESTPILOT_BASE_URL=https://api.openai.com/v1
# Optional integration: install with `npm install --no-save --package-lock=false @midscene/web@1.16.0`.
# Read-only visual cross-check using Midscene.js on the same Playwright page.
# This adds one multimodal assertion call per applicable case. Choose a family
# matching the configured vision model; it is not inferred from a generic API URL.
# TESTPILOT_MIDSCENE_VISUAL_ASSERT=1
# TESTPILOT_MIDSCENE_MODEL_FAMILY=qwen3-vl
# TESTPILOT_MIDSCENE_MODEL=your-vision-model-name
# PORT=4317
# Optional: CA certificate file for the MySQL read-only browser. The MySQL
# browser requires TLS with certificate validation; it never falls back to cleartext.
# TESTPILOT_MYSQL_CA_FILE=D:/certs/mysql-ca.pem
